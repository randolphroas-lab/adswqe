    <div class="cat"><span>✉️ Google谷歌邮箱</span><span class="count">0</span></div>
    <div class="cat"><span>📧 微软邮箱</span><span class="count">0</span></div>
    <div class="cat"><span>🎮 Discord</span><span class="count">4</span></div>
  </aside>

  <!-- 右侧商品 -->
  <main>
    <a class="item" href="index.html">
      <div class="icon">✈</div>
      <div class="info">
        <div class="title">Telegram账号 +1美国 API链接 新号</div>
      </div>
      <div class="right">
        <div class="stock">库存 1,430</div>
        <div class="price">¥25.00</div>
      </div>
