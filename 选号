<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>全部商品</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, "Microsoft YaHei", sans-serif;
    background: #f5f7fa;
    color: #222;
  }

  /* 顶部导航 */
  header {
    background: #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .logo {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff7a7a, #ff4d4d);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: bold; font-size: 14px;
  }
  nav { display: flex; gap: 20px; font-size: 15px; }
  nav a { color: #333; text-decoration: none; }
  nav a:hover { color: #1677ff; }

  /* 主体布局 */
  .container {
    max-width: 1100px;
    margin: 20px auto;
    display: flex;
    gap: 16px;
    padding: 0 16px;
  }

  /* 左侧分类 */
  aside {
    width: 220px;
    background: #fff;
    border-radius: 12px;
    padding: 12px 0;
    flex-shrink: 0;
    height: fit-content;
  }
  .cat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    font-size: 14px;
    color: #444;
  }
  .cat.active {
    background: #eaf3ff;
    color: #1677ff;
    font-weight: bold;
  }
  .cat .count { color: #999; font-size: 13px; }

  /* 右侧商品 */
  main {
    flex: 1;
    background: #fff;
    border-radius: 12px;
    padding: 8px 16px;
  }
  .item {
    display: flex;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #f0f0f0;
    text-decoration: none;
    color: inherit;
  }
  .item:last-child { border-bottom: none; }
  .icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: #2AABEE;
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    margin-right: 12px;
    flex-shrink: 0;
  }
  .info { flex: 1; }
  .title { font-size: 15px; line-height: 1.4; }
  .right { text-align: right; margin-left: 12px; flex-shrink: 0; }
  .stock { font-size: 12px; color: #999; margin-bottom: 4px; }
  .price { font-size: 16px; color: #e02020; font-weight: bold; }
  .arrow { color: #bbb; font-size: 18px; margin-left: 8px; }

  /* 手机适配 */
  @media (max-width: 700px) {
    .container { flex-direction: column; }
    aside { width: 100%; }
  }
</style>
</head>
<body>

<header>
  <div class="logo">A</div>
  <nav>
    <a href="shop.html">🏠网站首页</a>
